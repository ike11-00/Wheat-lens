# --- Python ---------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# --- Dataset images -------------------------------------------------
# Images are never committed: they are large, often licensed, and the
# prepared splits are reproducible from data/raw with a fixed seed.
data/raw/**
data/processed/**
data/train/**
data/validation/**
data/test/**
data/realistic/**
data/downloads/**
!data/**/.gitkeep
!data/realistic/manifest.csv

# --- Trained models -------------------------------------------------
# Weights are large binaries; retrain with `python -m src.model.train`.
models/**
!models/.gitkeep

# --- Generated results ----------------------------------------------
# Reports, graphs and CSVs are regenerated by the pipeline. Commit a
# specific report deliberately with `git add -f` if you want to keep it.
results/**/*
!results/**/
!results/**/.gitkeep

# --- Environment ----------------------------------------------------
.env
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/
